---
import '../styles/global.css';
import {getCollection} from 'astro:content';
import {categories, categorySlug, publishable} from '../lib/site';
const visiblePosts=(await getCollection('blog')).filter(publishable);
const activeCategories=categories.filter(cat=>visiblePosts.some(post=>categorySlug(post.data.category)===cat.id));
import { brand, description as baseDescription, siteReady, validOrigin } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'article' | 'website';
  preloadHero?: boolean;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
}
const {
  title,
  description = baseDescription,
  image = '/images/indoor-cat-enrichment-ideas-hero.webp',
  imageAlt = 'Editorial illustration of an indoor cat',
  imageWidth = 1280,
  imageHeight = 720,
  type = 'website',
  preloadHero = false,
  noindex = false,
  publishedTime,
  modifiedTime,
  section,
} = Astro.props;
const pageTitle = title ? `${title} | ${brand}` : `${brand} | Better days for indoor cats`;
const canIndex = siteReady && validOrigin && !noindex;
const canonical = canIndex ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = canIndex ? new URL(image, Astro.site).toString() : undefined;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="jn4f5kUIgYWBpqdnL1ff5O3T5lmJ3iDyBf_Ff9RuY9g" />
    <meta name="robots" content={canIndex ? 'index,follow' : 'noindex,nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/brand/autumn/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Mew & Maple" />
    {preloadHero && <link rel="preload" as="image" href={image} fetchpriority="high" />}
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={imageAlt} />}
    {ogImage && <meta property="og:image:width" content={String(imageWidth)} />}
    {ogImage && <meta property="og:image:height" content={String(imageHeight)} />}
    {canIndex && type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {canIndex && type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {canIndex && type === 'article' && section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={imageAlt} />}
    {canIndex && <link rel="alternate" type="application/rss+xml" title="Mew & Maple RSS" href={new URL('/rss.xml', Astro.site).toString()} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="theme-color" content="#263C34" />
  </head>
  <body>
    {import.meta.env.DEV && !canIndex && <div class="preview-banner" role="status">Draft preview — not approved for publication or indexing</div>}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="container header-inner">
      <a class="logo" href="/" aria-label="Mew & Maple homepage">
        <img class="logo-full" src="/brand/autumn/lockup.webp" alt="" width="360" height="120" decoding="async" loading="eager" fetchpriority="high" />
      </a>
      <nav aria-label="Main navigation"><a href="/start-here/">Start here</a><a href="/">Guides</a>{activeCategories.map(cat=><a href={`/category/${cat.id}/`}>{cat.id==='homes'?'Small spaces':cat.id==='play'?'Play':cat.id==='gear'?'Gear':'Everyday life'}</a>)}<a href="/notebook/">Notebook</a><a href="/search/">Search</a><a href="/about/">About</a></nav>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container footer-inner"><div><div class="footer-brand"><img class="footer-lockup" src="/brand/autumn/lockup.webp" alt="Mew & Maple — Better days for indoor cats" width="360" height="120" loading="lazy" decoding="async" /></div><p>Practical, safety-minded ideas for happier indoor-cat living.</p></div><div class="footer-links"><a href="/about/">About</a><a href="/editorial-policy/">Editorial policy</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/affiliate-disclosure/">Affiliate disclosure</a></div></div><div class="container legal-bottom">© {new Date().getFullYear()} Mew & Maple</div></footer>
  </body>
</html>
