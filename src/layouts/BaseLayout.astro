---
import '../styles/global.css';
import { brand, description as baseDescription, siteReady, validOrigin } from '../lib/site';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; type?: 'article' | 'website'; preloadHero?: boolean; }
const { title, description = baseDescription, image = '/images/indoor-cat-enrichment-ideas-hero.webp', imageAlt = 'Editorial illustration of an indoor cat', type = 'website', preloadHero = false } = Astro.props;
const pageTitle = title ? `${title} | ${brand}` : `${brand} | Better days for indoor cats`;
const canIndex = siteReady && validOrigin;
const canonical = canIndex ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = canIndex ? new URL(image, Astro.site).toString() : undefined;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="jn4f5kUIgYWBpqdnL1ff5O3T5lmJ3iDyBf_Ff9RuY9g" />
    <meta name="robots" content={canIndex ? 'index,follow' : 'noindex,nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/brand/autumn/cat-silhouette.webp" type="image/webp" sizes="96x96" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Mew & Maple" />
    {preloadHero && <link rel="preload" as="image" href={image} fetchpriority="high" />}
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={imageAlt} />}
    {canIndex && <link rel="alternate" type="application/rss+xml" title="Mew & Maple RSS" href={new URL('/rss.xml', Astro.site).toString()} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="theme-color" content="#263C34" />
  </head>
  <body>
    {!canIndex && <div class="preview-banner" role="status">Draft preview — not approved for publication or indexing</div>}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="container header-inner">
      <a class="logo" href="/" aria-label="Mew & Maple homepage">
        <img class="logo-full" src="/brand/autumn/lockup.webp" alt="" width="360" height="120" decoding="async" loading="eager" fetchpriority="high" />
      </a>
      <nav aria-label="Main navigation"><a href="/">All guides</a><a href="/category/play/">Play</a><a href="/category/homes/">Small spaces</a><a href="/category/gear/">Gear</a><a href="/category/care/">Care</a><a href="/search/">Search</a><a href="/about/">About</a></nav>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container footer-inner"><div><div class="footer-brand"><img class="footer-lockup" src="/brand/autumn/lockup.webp" alt="Mew & Maple — Better days for indoor cats" width="360" height="120" loading="lazy" decoding="async" /></div><p>Better days for indoor cats. Illustrations are editorial AI imagery, not evidence of hands-on product testing.</p></div><div class="footer-links"><a href="/about/">About</a><a href="/editorial-policy/">Editorial policy</a><a href="/privacy/">Privacy</a><a href="/affiliate-disclosure/">Affiliate disclosure</a></div></div><div class="container legal-bottom">© {new Date().getFullYear()} Mew & Maple · A working-brand editorial project</div></footer>
  </body>
</html>
