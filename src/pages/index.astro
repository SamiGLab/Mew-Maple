---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarterPaths from '../components/StarterPaths.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { publishable } from '../lib/site';
const posts = (await getCollection('blog')).filter(publishable);
---
<BaseLayout preloadHero>
  <section class="hero autumn-hero">
    <img class="autumn-leaf" src="/brand/autumn/maple-leaf.webp" alt="" width="128" height="128" decoding="async" loading="lazy" aria-hidden="true" />
    <div class="container hero-grid"><div><p class="eyebrow">INDOOR CAT LIVING</p><h1>Better days for <em>indoor cats.</em></h1><p class="lead">Thoughtful play ideas, small-space solutions, and everyday routines for sharing your home with indoor cats.</p><a class="button" href="/start-here/">Find your starting point <span aria-hidden="true">↗</span></a></div><div class="hero-image"><img src="/images/indoor-cat-enrichment-ideas-hero.webp" alt="Illustration of an indoor tabby cat exploring a food puzzle" width="1280" height="720" loading="eager" decoding="async" fetchpriority="high" /></div></div></section>
  <section class="container start-section"><p class="eyebrow">ONE THOUGHTFUL CHANGE</p><h2>What would make today easier?</h2><StarterPaths /></section>
  <section class="container autumn-reading" id="guides"><div class="section-head"><div><p class="eyebrow">THE READING ROOM</p><h2>Guides for everyday cat life</h2></div><p>Practical ideas designed to fit real homes and real routines.</p></div>
    <div class="article-grid">{posts.map(post => <ArticleCard post={post} />)}</div>
    {posts.length === 0 &&
      <div class="prelaunch-reading"><p>Begin with a small plan you can use today: an optional weekly activity sheet or a home walk-through.</p><a href="/notebook/">Explore the free Notebook →</a></div>
    }
  </section>
  <section class="container reading-panel home-story"><p class="eyebrow">WHY MEW &amp; MAPLE</p><h2>Real homes. Individual cats.</h2><p>We favor useful changes that fit the space and routine you have. Our guides explain sources, trade-offs and practical ways to adapt each idea.</p><a href="/about/">Get to know our approach →</a></section>
</BaseLayout>
