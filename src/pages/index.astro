---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { publishable, siteReady, localReviewMode } from '../lib/site';
const posts = (await getCollection('blog')).filter(publishable);
const topicCards = [
  { slug: 'play', title: 'Play & Enrichment', summary: 'Keep curious minds busy with fresh, practical activities.', image: '/images/indoor-cat-enrichment-ideas-hero.webp' },
  { slug: 'homes', title: 'Cat-Friendly Homes', summary: 'Create calm corners and more useful spaces for indoor cats.', image: '/images/cat-friendly-apartment-hero.webp' },
  { slug: 'gear', title: 'Gear & Buying Guides', summary: 'Compare the features that matter before choosing cat gear.', image: '/images/cat-trees-small-apartments-hero.webp' },
  { slug: 'care', title: 'Everyday Cat Life', summary: 'Build comfortable routines that fit the cats in your home.', image: '/images/home-for-two-indoor-cats-hero.webp' },
];
---
<BaseLayout preloadHero>
  <section class="hero"><div class="container hero-grid"><div><p class="eyebrow">INDOOR CAT LIVING</p><h1>Better days for <em>indoor cats.</em></h1><p class="lead">Thoughtful play ideas, small-space solutions, and practical guides for living well with indoor cats.</p><a class="button" href="#guides">Explore the guides <span aria-hidden="true">↗</span></a></div><div class="hero-image"><img src="/images/indoor-cat-enrichment-ideas-hero.webp" alt="Illustration of an indoor tabby cat exploring a food puzzle" width="1280" height="720" loading="eager" decoding="async" fetchpriority="high" /></div></div></section>
  <section class="container" id="guides"><div class="section-head"><div><p class="eyebrow">THE READING ROOM</p><h2>Guides for everyday cat life</h2></div><p>Practical ideas designed to fit real homes and real routines.</p></div>
    <div class="article-grid">{posts.map(post => <ArticleCard post={post} />)}</div>
    {posts.length === 0 &&
      <div class="topic-preview">
        <p class="note">Our guide library is being prepared. Explore the topics below; full articles will appear after editorial review.</p>
        <div class="topic-grid" aria-label="Indoor cat living topics">
          {topicCards.map(topic =>
            <a class="topic-card" href={`/category/${topic.slug}/`} aria-label={`${topic.title}: explore this topic`}>
              <img src={topic.image} alt="" width="640" height="360" loading="lazy" decoding="async" />
              <span class="topic-content"><strong>{topic.title}</strong><span>{topic.summary}</span><span class="topic-cta">Explore topic →</span></span>
            </a>
          )}
        </div>
        <p class="topic-disclosure">Illustrations are AI-generated editorial examples, not evidence of hands-on product testing.</p>
      </div>
    }
    {localReviewMode && <p class="note">Local review only: these draft guides are not approved for publication. Illustrations are AI-generated and do not represent firsthand product testing.</p>}
    {siteReady && <p class="note">Illustrations are editorial AI imagery, not evidence of firsthand product testing.</p>}
  </section>
</BaseLayout>
