---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { publishable, siteReady } from '../../lib/site';
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(publishable);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const publicationDate = post.data.publishedAt?.toISOString();
const schema = siteReady && post.data.status === 'published' ? {
  '@context':'https://schema.org', '@type':'BlogPosting',
  headline:post.data.title,description:post.data.description, inLanguage:'en-US',
  image:new URL(post.data.hero, Astro.site).toString(),
  publisher:{'@type':'Organization',name:'Mew & Maple'},
  author:{'@type':'Organization',name:'Mew & Maple'},
  mainEntityOfPage:new URL(Astro.url.pathname, Astro.site).toString(),
  ...(publicationDate ? { datePublished: publicationDate } : {}),
  ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
}:null;
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.hero} type="article">
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <article class="container article-container">
    <p class="eyebrow"><a href="/">All guides</a> / {post.data.category}</p>
    <h1>{post.data.title}</h1>
    <p class="article-byline">{siteReady ? 'Mew & Maple · ' : 'Editorial draft · '}{post.data.readingMinutes} min read · en-US</p>
    <figure class="article-hero"><img src={post.data.hero} alt={post.data.heroAlt} width="1280" height="720" /><figcaption>AI-generated editorial illustration; not a photograph of a tested product.</figcaption></figure>
    {post.data.affiliate && <p class="affiliate-notice">We may earn a commission if you buy through links in this article. This does not change your price.</p>}
    <div class="article-prose"><Content /></div>
    <div class="article-end"><p>Cat behavior and needs vary. For sudden behavioral changes, health concerns, or individualized medical advice, speak with your veterinarian.</p><a href="/">← Explore more guides</a></div>
  </article>
</BaseLayout>
